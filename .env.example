# ─────────────────────────────────────────────────────────────
# AI Email Reading Agent — environment configuration
# Copy to .env and fill in. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────

# Which email source to read from: mock | gmail
# - mock  : reads data/mock_emails.json (no credentials needed, default)
# - gmail : reads Gmail over IMAP (uses imap.gmail.com automatically)
EMAIL_SOURCE=mock

# How often the agent polls the inbox, in seconds (task suggests ~120)
POLL_INTERVAL=120

# ── DeepSeek AI (optional) ────────────────────────────────────
# If set, the classifier refines rule-based decisions with DeepSeek.
# If empty, the agent falls back to the rule-based classifier only,
# so mock mode works fully offline with no key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Gmail (only used when EMAIL_SOURCE=gmail) ─────────────────
# Create an "App Password" at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Use it below — NOT your login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Mailbox/label to read (optional, defaults to INBOX)
IMAP_FOLDER=INBOX
# Max unread emails to process per poll cycle (newest first). Keeps a large
# inbox backlog from triggering thousands of classifications at once.
GMAIL_MAX_FETCH=20

# ── Shared SQLite database path (agent + dashboard) ──────────
# Relative path for local runs. Docker Compose overrides this with /data/agent.db
# (a shared volume) automatically, so leave it relative here.
DB_PATH=data/agent.db

# ── Single-service mode (optional) ───────────────────────────
# Set to 1 to run the agent loop INSIDE the dashboard web service as a background
# thread (for hosts with no background workers, e.g. Render free tier). Leave
# unset for Docker/local, which run the agent and dashboard as two services.
RUN_AGENT_IN_PROCESS=
